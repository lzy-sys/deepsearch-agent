# ============================================================
# DeepSearch Agents 环境变量示例
# 使用方式：复制本文件为 .env 并按本机实际服务填写
#   cp .env.example .env
# 注意：.env 已加入 .gitignore，禁止提交真实密钥
# ============================================================

# ---------- LLM 配置（OpenAI 兼容接口） ----------
# 模型服务基础地址（例如 DashScope 兼容模式 / 其他 OpenAI 兼容网关）
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 大模型 API Key
OPENAI_API_KEY=your_llm_api_key
# 主智能体与子智能体统一使用的模型名
LLM=qwen-max

# ---------- Tavily 网络搜索配置 ----------
# 在 https://app.tavily.com/ 注册账号并创建 API Key
TAVILY_API_KEY=your_tavily_api_key

# ---------- 自研知识库 RAG 配置（本地摄取 + ChromaDB/BM25 检索） ----------
# 知识库根目录：每个子目录 = 一个知识库（可选 kb.yaml 提供 name/description）
RAG_KB_DIR=docs/knowledge_base
# 索引目录（ChromaDB 持久化 + BM25 pickle），已加入 .gitignore
RAG_INDEX_DIR=data/rag
# 分块参数
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
# 检索 Top-K 与模式（hybrid | bm25 | vector）
RAG_TOP_K=4
RAG_RETRIEVER=hybrid
# 向量模型（fastembed/ONNX，首次运行需联网下载权重）
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ---------- MySQL 配置 ----------
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=deepsearch_db
MYSQL_HOST=localhost
# docker/docker-compose.yaml 建议映射到 3307，避免与本机已有 MySQL 3306 冲突
MYSQL_PORT=3307
# 与初始化 SQL 和 Docker MySQL 服务保持一致，保证中文数据按 utf8mb4 读写
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci
MYSQL_SQL_MODE=TRADITIONAL

# ---------- CORS 跨域配置 ----------
# 允许的前端来源，多个用英文逗号分隔；默认本地 Vite 开发地址
CORS_ORIGINS=http://localhost:5173
